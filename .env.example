# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Add the Tailscale URL when running on the Mac mini, e.g. http://mac-mini:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=confighub
POSTGRES_USER=confighub
POSTGRES_PASSWORD=confighub-local-db

# Password for all demo users created by `manage.py seed_demo` (test data only).
DEMO_PASSWORD=Demo-pass-2026

# Email: leave as is to print emails (e.g. password reset links) to `docker compose logs web`.
# For real delivery, switch to SMTP and fill in your provider's settings:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=ConfigHub <noreply@example.com>
